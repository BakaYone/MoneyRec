<Window x:Class="MoneyRec.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MoneyRec.WPF.Views"
        mc:Ignorable="d"
        Title="Главная" Height="450" Width="800" Background="{StaticResource PrimaryBackgroundBrush}">
    <Grid>
       <Grid.ColumnDefinitions>
            <ColumnDefinition Width=".3*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource SecondaryGreenBrush}">
            
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height=".1*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,10,0,0" >
                <Image Source="/Resourses/Assets/Capitalism.png" MaxHeight="100"/>
                <Button Content="Счета" Command="{Binding ChangeInstanceCommand}" CommandParameter="1" Margin="0,20"/>
                <Button Content="Категории" Command="{Binding ChangeInstanceCommand}" CommandParameter="2" Margin="0,20"/>
                <Button Content="Операции" Command="{Binding ChangeInstanceCommand}" CommandParameter="3" Margin="0,20"/>
            </StackPanel>
            <Button Style="{StaticResource SecondaryButton}" Grid.Row="1" Content="Профиль" Command="{Binding ChangeInstanceCommand}" CommandParameter="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,10"/>
        </Grid>
        <Rectangle Grid.Column="1" Fill="{StaticResource PrimaryBrush}"></Rectangle>
        <Grid Grid.Column="2" Margin="10,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height=".1*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="{Binding PageLabel}" FontSize="50" FontWeight="DemiBold"/>
            <Frame Grid.Row="1" Content="{Binding CurrentInstance}" NavigationUIVisibility="Hidden"/>
        </Grid>
        
    </Grid> 
</Window>
