<Window x:Class="MoneyRec.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MoneyRec.WPF.Views"
        mc:Ignorable="d"
        Title="Главная" Height="450" Width="800">
    <Grid>
       <Grid.ColumnDefinitions>
            <ColumnDefinition Width=".3*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height=".1*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="Счета" Command="{Binding ChangeInstanceCommand}" CommandParameter="1"/>
                <Button Content="Категории" Command="{Binding ChangeInstanceCommand}" CommandParameter="2"/>
                <Button Content="Операции" Command="{Binding ChangeInstanceCommand}" CommandParameter="3"/>
            </StackPanel>
            <Button Grid.Row="1" Content="Профиль" Command="{Binding ChangeInstanceCommand}" CommandParameter="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <Rectangle Grid.Column="1" Fill="Black"></Rectangle>
        <Frame Grid.Column="2" Content="{Binding CurrentInstance}" NavigationUIVisibility="Hidden"/>
    </Grid> 
</Window>
