<Window x:Class="MoneyRec.WPF.ManageDialogWindows.AccountManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MoneyRec.WPF.ManageDialogWindows"
        mc:Ignorable="d"
        Title="AccountManageWindow" Height="450" Width="800">
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200">
        <Label Content="Название"/>
        <TextBox Text="{Binding Title}"/>
        <Label Content="Баланс"/>
        <TextBox Text="{Binding Balance}"/>
        <Button Content="Подтвердить" Command="{Binding SubmitManageCommand}"/>
    </StackPanel>
</Window>
