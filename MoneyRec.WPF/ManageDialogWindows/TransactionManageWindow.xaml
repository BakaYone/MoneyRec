<Window x:Class="MoneyRec.WPF.ManageDialogWindows.TransactionManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MoneyRec.WPF.ManageDialogWindows"
        mc:Ignorable="d"
        Title="TransactionManageWindow" Height="450" Width="800">
    <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Width="250">
        <Label Content="Категория"/>
        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Label Content="Счет"/>
        <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Label Content="Сумма"/>
        <TextBox Text="{Binding Amount}"/>

        <Label Content="Дата"/>
        <DatePicker SelectedDate="{Binding CreatedAt}"/>

        <Label Content="Описание"/>
        <TextBox Text="{Binding Description}"/>

        <Button Content="Подтвердить" Command="{Binding SubmitCommand}"/>
    </StackPanel>
</Window>
