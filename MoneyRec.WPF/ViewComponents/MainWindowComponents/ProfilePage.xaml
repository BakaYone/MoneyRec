<Page x:Class="MoneyRec.WPF.ViewComponents.MainWindowComponents.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MoneyRec.WPF.ViewComponents.MainWindowComponents"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Профиль">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height=".1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width=".5*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{StaticResource PrimaryBrush}" CornerRadius="5" Margin="5,5,5,5" Padding="5">
            <Image  Source="/Resourses/Assets/Avatar.png"/>
        </Border>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0">
            <TextBlock Text="{Binding Login, StringFormat='Логин: \{0\}'}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Email, StringFormat='Почта: \{0\}'}" FontSize="20" FontWeight="SemiBold"/>
        </StackPanel>
        <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Редактировать" Command="{Binding ManageCommand}" Margin="0,0,10,10" Cursor="Hand"/>
    </Grid>
</Page>
