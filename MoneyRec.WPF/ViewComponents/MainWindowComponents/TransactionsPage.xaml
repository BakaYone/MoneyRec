<Page x:Class="MoneyRec.WPF.ViewComponents.MainWindowComponents.TransactionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MoneyRec.WPF.ViewComponents.MainWindowComponents"
      xmlns:b="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Транзакции">

    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
        </Style>
    </Page.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height=".1*"/>
        </Grid.RowDefinitions>

        <ListBox Grid.Row="0" SelectedItem="{Binding Selected}" ItemsSource="{Binding Transactions}">
            <b:Interaction.Triggers>
                <b:EventTrigger EventName="MouseDoubleClick">
                    <b:InvokeCommandAction Command="{Binding ManageCommand}"/>
                </b:EventTrigger>
            </b:Interaction.Triggers>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,20,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/> 
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Category.Title, StringFormat='Категория: \{0\}'}" HorizontalAlignment="Left" Margin="0,0,50,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="50,0,0,0">
                                    <TextBlock Text="{Binding Account.Title, StringFormat='Счет: \{0\}'}" Margin="10,0"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='Дата: \{0:d\}'}"/>
                                </StackPanel>
                            </Grid>
                        
                        
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="{Binding Description, StringFormat='Описание: \{0\}'}" Margin="0,10,50,10" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat='Сумма: \{0:C\}', ConverterCulture=ru-RU}" Margin="50, 10,0,10" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                        
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" Margin="10" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="Добавить" Command="{Binding AddCommand}" />
         
        </StackPanel>
        
        
    </Grid>
</Page>
