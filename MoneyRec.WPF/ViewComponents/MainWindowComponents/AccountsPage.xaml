<Page x:Class="MoneyRec.WPF.ViewComponents.MainWindowComponents.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MoneyRec.WPF.ViewComponents.MainWindowComponents"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Счета">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height=".1*"/>
        </Grid.RowDefinitions>
    
    <ListBox Grid.Row="0" ItemsSource="{Binding Accounts}">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width=".2*"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="/Resourses/Assets/Capitalism.png" MaxHeight="25" MaxWidth="25"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title, TargetNullValue='null'}" FontSize="18"/>
                    <TextBlock Grid.Column="2" Text="{Binding Balance, StringFormat='\{0:C2\}', TargetNullValue='0', ConverterCulture=ru-RU}" FontSize="18"/>
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
        <Button Grid.Row="1" Content="Добавить" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
</Page>
