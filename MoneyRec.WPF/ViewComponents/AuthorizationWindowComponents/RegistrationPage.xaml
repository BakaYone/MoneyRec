<Page x:Class="MoneyRec.WPF.ViewComponents.LoginWindowComponents.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MoneyRec.WPF.ViewComponents.LoginWindowComponents"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegistrationPage">

    <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Label Content="Регистрация" FontWeight="Bold" FontSize="20"/>
        
        <Label Content="Логин"/>
        <TextBox Text="{Binding Login}"/>
        
        <Label Content="Почта"/>
        <TextBox Text="{Binding Email}"/>
        
        <Label Content="Пароль"/>
        <TextBox Text="{Binding Password}"/>
        
        <Label Content="Повторите пароль"/>
        <TextBox Text="{Binding RePassword}"/>

        <Button Content="Подтвердить" Margin="0,15,0,0"/>
    </StackPanel>
</Page>
